<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>媒体库</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于把查看中的照片保存到系统相册</string>
	<!-- ⚠️ 只保留 NSAllowsArbitraryLoads。iOS 10+ 若 plist 里同时出现
	     NSAllowsLocalNetworking / NSAllowsArbitraryLoadsInWebContent /
	     NSAllowsArbitraryLoadsForMedia 任意一个，系统会忽略 NSAllowsArbitraryLoads
	     （按默认值 NO 处理），只剩「本地网络例外」生效：局域网 IP 能连，
	     但 Tailscale MagicDNS 域名(xxx.ts.net) 和 100.x CGNAT 地址会被 ATS 拦成 -1022。
	     部署目标是 iOS 17，不需要为兼容 iOS 9 而同时设两个 key。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- 注册自家 URL scheme：VidHub 播放结束时按 x-callback-url 契约把
	     mediamanager://x-callback-url/success|error|cancel 打回来，
	 App 靠 .onOpenURL 收进度。scheme 必须与代码里 VidHubBridge.scheme 一致 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>media-hub</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mediamanager</string>
			</array>
		</dict>
	</array>
	<!-- VidHub 外播：不声明的话 UIApplication.canOpenURL 对 open-vidhub://
	     一律返回 false（装了也会被当成没装），跳转直接失效 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>open-vidhub</string>
	</array>
</dict>
</plist>
